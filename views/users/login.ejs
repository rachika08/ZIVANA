<% layout('/layouts/boilerplate') -%>

<div class="form-page">
  <div class="form-card">
    <p class="form-page-subtitle"><i class="fa-solid fa-compass me-1" style="color:var(--accent)"></i> Welcome back</p>
    <h1 class="form-page-title">Log in to<br><em>Zivana</em></h1>

    <form action="/login" method="POST" class="needs-validation mt-4" novalidate>
      <div class="mb-4">
        <label for="username" class="form-label">Username</label>
        <input type="text" name="username" id="username" class="form-control" placeholder="your_username" required>
        <div class="invalid-feedback">Please enter your username.</div>
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="••••••••" required>
        <div class="invalid-feedback">Please enter your password.</div>
      </div>
      <button type="submit" class="btn-primary-zivana">
        <i class="fa-solid fa-arrow-right-to-bracket"></i> Log In
      </button>
    </form>

    <div class="auth-alt-link">
      Don't have an account? <a href="/signup">Sign up for free</a>
    </div>
  </div>
</div>
