<script>
  (function () {
    // --- Generic Toggle Setup Function ---
    function setupSearchToggle(toggleId, formId, inputId, closeId) {
      const toggleBtn  = document.getElementById(toggleId);
      const expandForm = document.getElementById(formId);
      const input      = document.getElementById(inputId);
      const closeBtn   = document.getElementById(closeId);

      if (!toggleBtn || !expandForm || !input || !closeBtn) return;

      function openSearch() {
        expandForm.classList.add('open');
        toggleBtn.style.display = 'none';
        setTimeout(() => input.focus(), 50);
      }

      function closeSearch() {
        expandForm.classList.remove('open');
        toggleBtn.style.display = '';
      }

      toggleBtn.addEventListener('click', openSearch);
      closeBtn.addEventListener('click', closeSearch);

      // Close on Escape key
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSearch();
      });
    }

    // Initialize Desktop Search
    setupSearchToggle('searchToggleBtn', 'searchExpandForm', 'searchExpandInput', 'searchCloseBtn');

    // Initialize Mobile Search
    setupSearchToggle('mobileSearchToggleBtn', 'mobileSearchExpandForm', 'mobileSearchExpandInput', 'mobileSearchCloseBtn');

    // Close desktop search when clicking outside
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('searchToggleWrap');
      const expandForm = document.getElementById('searchExpandForm');
      const toggleBtn  = document.getElementById('searchToggleBtn');
      if (wrap && !wrap.contains(e.target) && expandForm) {
        expandForm.classList.remove('open');
        if (toggleBtn) toggleBtn.style.display = '';
      }
    });
  })();
</script>

