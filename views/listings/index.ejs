<% layout('/layouts/boilerplate') -%>

<div id="filters">
  <div class="filter" title="Trending">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>
  <div class="filter" title="Rooms">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </div>
  <div class="filter" title="Iconic Cities">
    <i class="fa-solid fa-mountain-city"></i>
    <p>Iconic Cities</p>
  </div>
  <div class="filter" title="Mountains">
    <i class="fa-solid fa-mountain"></i>
    <p>Mountains</p>
  </div>
  <div class="filter" title="Castles">
    <i class="fa-brands fa-fort-awesome"></i>
    <p>Castles</p>
  </div>
  <div class="filter" title="Amazing Pools">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Amazing Pools</p>
  </div>
  <div class="filter" title="Camping">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </div>
  <div class="filter" title="Farms">
    <i class="fa-solid fa-cow"></i>
    <p>Farms</p>
  </div>
  <div class="filter" title="Arctic">
    <i class="fa-solid fa-snowflake"></i>
    <p>Arctic</p>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault" style="font-size:0.8rem;font-weight:500;">Total after taxes</label>
    </div>
  </div>
</div>

<div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-2 row-cols-1 mt-2 g-3">
  <% for(let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="listing-card">
          <div class="card-img-wrapper">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
            <div class="card-img-overlay-new"></div>
          </div>
          <div class="card-body">
            <div class="card-title-text"><%= listing.title %></div>
            <div class="card-price">
              <strong>&#8377;<%= listing.price ? listing.price.toLocaleString() : "N/A" %></strong> / night
              <i class="tax-info">&nbsp;+18% GST</i>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  let tagSwitch = document.getElementById("switchCheckDefault");
  tagSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      info.style.display = (info.style.display !== "inline") ? "inline" : "none";
    }
  });

  // Filter active state (visual only)
  document.querySelectorAll('.filter').forEach(f => {
    f.addEventListener('click', () => {
      document.querySelectorAll('.filter').forEach(x => x.classList.remove('active'));
      f.classList.add('active');
    });
  });
</script>
