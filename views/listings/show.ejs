<% layout('/layouts/boilerplate') -%>

<div class="py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

      <!-- Hero Image -->
      <div class="show-hero">
        <img src="<%= allInformation.image.url %>" alt="<%= allInformation.title %>">
      </div>

      <!-- Title & Owner -->
      <h1 class="show-title"><%= allInformation.title %></h1>
      <p class="show-owner">
        <i class="fa-solid fa-user-circle" style="color:var(--brown);margin-right:.3rem"></i>
        Hosted by <em><%= allInformation.owner.username %></em>
      </p>

      <!-- Meta Pills -->
      <div class="show-meta">
        <span class="show-meta-pill">
          <i class="fa-solid fa-location-dot"></i> <%= allInformation.location %>
        </span>
        <span class="show-meta-pill">
          <i class="fa-solid fa-earth-asia"></i> <%= allInformation.country %>
        </span>
      </div>

      <!-- Description -->
      <p class="show-description"><%= allInformation.description %></p>

      <!-- Price -->
      <div class="show-price-box">
        <span class="show-price-number">&#8377;<%= allInformation.price ? allInformation.price.toLocaleString() : "0" %></span>
        <span class="show-price-label">/ night</span>
      </div>

      <!-- Owner Actions -->
      <% if (currUser && allInformation.owner._id.equals(currUser._id)) { %>
        <div class="owner-actions">
          <a href="/listings/<%= allInformation._id %>/edit" class="btn-edit">
            <i class="fa-solid fa-pen-to-square"></i> Edit Listing
          </a>
          <form method="post" action="/listings/<%= allInformation._id %>?_method=DELETE" style="margin:0">
            <button type="submit" class="btn-delete">
              <i class="fa-solid fa-trash-can"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

      <hr class="section-divider">

      <!-- Review Form -->
      <% if (currUser) { %>
        <h3 class="review-form-title">Leave a Review</h3>
        <form action="/listings/<%= allInformation._id %>/reviews" method="post" novalidate class="needs-validation mb-4">
          <div class="mb-3">
            <label class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Your Comment</label>
            <textarea name="review[comment]" id="comment" rows="4" class="form-control" placeholder="Share your experience..." required></textarea>
            <div class="invalid-feedback">Please add your feedback.</div>
          </div>
          <button type="submit" class="btn-review-submit">
            <i class="fa-solid fa-paper-plane me-2"></i>Submit Review
          </button>
        </form>
        <hr class="section-divider">
      <% } %>

      <!-- All Reviews -->
      <% if (allInformation.reviews.length > 0) { %>
        <h3 class="all-reviews-title">Guest Reviews</h3>
        <div class="row g-3 mb-4">
          <% for (let review of allInformation.reviews) { %>
            <div class="col-md-6">
              <div class="card review-card h-100">
                <div class="card-body p-3">
                  <h5 class="review-author">@<%= review.author.username %></h5>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="review-comment mb-2"><%= review.comment %></p>
                </div>
                <% if (currUser && review.author._id.equals(currUser._id)) { %>
                  <div class="px-3 pb-3">
                    <form method="post" action="/listings/<%= allInformation._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button type="submit" class="btn-review-delete">
                        <i class="fa-solid fa-trash-can me-1"></i>Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
        <hr class="section-divider">
      <% } %>

      <!-- Map -->
      <h3 class="map-section-title">
        <i class="fa-solid fa-map-pin me-2" style="color:var(--accent);font-size:1.2rem"></i>Where you'll be
      </h3>
      <% if (allInformation.geometry && allInformation.geometry.coordinates) { %>
        <div id="map"
          data-geometry='<%- JSON.stringify(allInformation.geometry) %>'
          data-title="<%= allInformation.title %>">
        </div>
      <% } else { %>
        <p class="text-muted">Location not available.</p>
      <% } %>

      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const mapDiv = document.getElementById("map");
          if (mapDiv && mapDiv.dataset.geometry) {
            const geometry = JSON.parse(mapDiv.dataset.geometry);
            const [lng, lat] = geometry.coordinates;
            const map = L.map("map").setView([lat, lng], 13);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
              attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup(mapDiv.dataset.title);
          }
        });
      </script>

    </div>
  </div>
</div>
