<% layout('/layouts/boilerplate') -%>



<!-- Hero -->
<section class="landing-hero">
    <div class="landing-hero-inner">
        <span class="landing-eyebrow">Curated Stays Worldwide</span>

        <h1>Find a place that feels <em>like home</em></h1>

        <p>
            Handpicked homes, villas, and cabins from hosts who care about the details —
            view a stay that fits the trip you're actually taking.
        </p>

        <div class="landing-hero-actions">
            <a href="/listings" class="btn-landing-primary">
                <i class="fa-solid fa-compass"></i> Explore Stays
            </a>
            <a href="#about" class="btn-landing-ghost">
                How Zivana works
            </a>
        </div>
    </div>

    <div class="hero-float-card">
        <div class="stars">★★★★★</div>
        <div>
            <strong>4.9 / 5</strong>
            <span>from 10,000+ guests</span>
        </div>
    </div>
</section>


<!-- About -->
<section class="landing-about" id="about">
    <div class="about-grid">
        <!-- <div class="about-mark">“</div> -->

        <div>
            <h2>Welcome to Zivana</h2>
            <p>
                Zivana helps travelers discover exceptional places to stay, without the
                guesswork. Every listing is reviewed for quality, so what you see is what
                you get when you arrive.
            </p>
            <p>
                Whether it's a weekend escape or a long stay somewhere new, browse by
                location, price, or the kind of trip you're planning — and book in minutes.
            </p>
        </div>
    </div>
</section>


<!-- Features -->
<section class="landing-features" id="features">
    <div class="features-head">
        <h2>Why travelers choose Zivana</h2>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-house"></i></div>
            <h3>Handpicked Homes</h3>
            <p>Every stay is reviewed for quality before it's listed, so there are no surprises at check-in.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-star"></i></div>
            <h3>Trusted Reviews</h3>
            <p>Real feedback from real guests, so you know exactly what to expect.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-tag"></i></div>
            <h3>Transparent Pricing</h3>
            <p>The price you see is the price you pay — no hidden fees added at checkout.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-map-location-dot"></i></div>
            <h3>Amazing Locations</h3>
            <p>From city apartments to mountain cabins, find a setting that matches the trip.</p>
        </div>
    </div>
</section>


<!-- Stats -->
<section class="landing-stats">
    <div class="stats-row">
        <div class="stat-item">
            <h3>500+</h3>
            <p>Properties</p>
        </div>

        <div class="stat-item">
            <h3>50+</h3>
            <p>Cities</p>
        </div>

        <div class="stat-item">
            <h3>10K+</h3>
            <p>Happy Guests</p>
        </div>

        <div class="stat-item">
            <h3>4.9 ★</h3>
            <p>Average Rating</p>
        </div>
    </div>
</section>


<!-- CTA -->
<section class="landing-cta">
    <h2>Ready for your <em>next adventure?</em></h2>
    <p>Your next stay is a search away.</p>

    <a href="/listings" class="btn-landing-primary">
        <i class="fa-solid fa-arrow-right"></i> Browse Listings
    </a>
</section>
